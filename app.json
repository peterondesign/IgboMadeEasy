{
  "expo": {
    "name": "IgboMadeEasy",
    "slug": "igbo-made-easy",
    "owner": "petedgt",
    "scheme": "igbomadeeasy",
    "version": "1.2.0",
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/a3f01ad1-dd08-400b-a04b-f07b9e3343b6",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/IgboMadeEasy_Logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.igbomadeeasy.app",
      "buildNumber": "2",
      "icon": "./assets/IgboMadeEasy_Logo.png",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.igbomadeeasy.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/IgboMadeEasy_Logo.png",
        "backgroundColor": "#0D0F14"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/IgboMadeEasy_Logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "a3f01ad1-dd08-400b-a04b-f07b9e3343b6"
      }
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      "expo-notifications",
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset"
    ]
  }
}
